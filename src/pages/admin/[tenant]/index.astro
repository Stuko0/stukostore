---
import Admin from '../../../layouts/Admin.astro';
import Dashboard from '../../../components/admin/Dashboard.tsx';
import { tenantBySlug, tenantsPathParams } from '../../../lib/seed-source';

export function getStaticPaths() {
  return tenantsPathParams();
}

const tenant = tenantBySlug(Astro.params.tenant!);
---

<Admin tenant={tenant} title={`Resumen — ${tenant.name}`} section="resumen">
  <Dashboard client:load tenant={tenant} />
</Admin>
