---
import Admin from '../../../../layouts/Admin.astro';
import OrderDetail from '../../../../components/admin/OrderDetail.tsx';
import { tenantBySlug, tenantsPathParams } from '../../../../lib/seed-source';

export function getStaticPaths() {
  return tenantsPathParams();
}

const tenant = tenantBySlug(Astro.params.tenant!);
---

<Admin tenant={tenant} title={`Pedido — ${tenant.name}`} section="pedidos">
  <OrderDetail client:load tenant={tenant} />
</Admin>
