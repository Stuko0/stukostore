---
import Admin from '../../../../layouts/Admin.astro';
import OrderTable from '../../../../components/admin/OrderTable.tsx';
import { tenantBySlug, tenantsPathParams } from '../../../../lib/seed-source';

export function getStaticPaths() {
  return tenantsPathParams();
}

const tenant = tenantBySlug(Astro.params.tenant!);
---

<Admin tenant={tenant} title={`Pedidos — ${tenant.name}`} section="pedidos">
  <OrderTable client:load tenant={tenant} />
</Admin>
