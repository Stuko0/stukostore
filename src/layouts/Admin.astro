---
// Marco del panel de administración de una tienda.
import '../styles/global.css';
import type { Tenant } from '../lib/types';
import TierDock from '../components/tier/TierDock.tsx';
import AdminNav from '../components/admin/AdminNav.tsx';

interface Props {
  tenant: Tenant;
  title: string;
  section: string;
}

const { tenant, title, section } = Astro.props;
---

<!doctype html>
<html lang="es-BO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`Panel de administración de ${tenant.name} en StukoStore.`} />
    <meta name="robots" content="noindex" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <div class="admin">
      <aside class="admin__rail">
        <a class="admin__brand" href="/admin/{tenant.slug}/">
          <span class="mono" aria-hidden="true">{tenant.monogram}</span>
          {tenant.name}
        </a>
        <AdminNav client:load tenantSlug={tenant.slug} current={section} />
        <a class="admin__store" href={`/t/${tenant.slug}/`}>
          Ver tienda <span aria-hidden="true">→</span>
        </a>
      </aside>

      <main class="admin__main" id="contenido">
        <slot />
      </main>
    </div>

    <TierDock client:load />
  </body>
</html>
