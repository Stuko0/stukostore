---
// Marco del storefront de una tienda: barra de anuncios con el beneficio de la
// tienda, encabezado con su tema, banda deslizante y pie con el crédito.
import '../styles/global.css';
import type { Collection, Tenant } from '../lib/types';
import CartWidget from '../components/store/CartWidget.tsx';
import BrandCredit from '../components/store/BrandCredit.tsx';
import TierDock from '../components/tier/TierDock.tsx';

interface Props {
  tenant: Tenant;
  collections: Collection[];
  title: string;
  description: string;
  announcement?: string;
}

const { tenant, collections, title, description } = Astro.props;
const aviso =
  Astro.props.announcement ??
  `Envío gratis desde Bs.- 299 en ${tenant.city} · Cambios dentro de 7 días`;

const themeStyle = [
  `--brand-bar-bg:${tenant.theme.barBg}`,
  `--brand-bar-fg:${tenant.theme.barFg}`,
  `--brand-accent:${tenant.theme.accent}`,
].join(';');
---

<!doctype html>
<html lang="es-BO" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="theme-color" content={tenant.theme.barBg} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/jost-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <div class="announce" role="region" aria-label="Avisos de la tienda">
      <div class="shell announce__inner">
        <p>{aviso}</p>
      </div>
    </div>

    <header class="bar">
      <div class="shell bar__inner">
        <a class="bar__brand" href={`/t/${tenant.slug}/`}>
          <span class="mono" aria-hidden="true">{tenant.monogram}</span>
          {tenant.name}
        </a>
        <nav class="bar__nav" aria-label="Categorías">
          <a href={`/t/${tenant.slug}/`}>Inicio</a>
          {
            collections.slice(0, 5).map((c) => (
              <a href={`/t/${tenant.slug}/c/${c.slug}/`}>{c.title}</a>
            ))
          }
          <a href={`/t/${tenant.slug}/buscar/`}>Buscar</a>
          <a href={`/admin/${tenant.slug}/`}>Panel</a>
        </nav>
        <CartWidget client:load tenantId={tenant.id} tenantSlug={tenant.slug} />
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {
          [0, 1, 2, 3].map(() => (
            <>
              <span>{tenant.name}</span>
              <span>{tenant.tagline}</span>
            </>
          ))
        }
      </div>
    </div>

    <footer class="foot">
      <div class="shell foot__inner">
        <span>{tenant.name} — {tenant.city}, Bolivia</span>
        <span class="caption">
          <a href={`/t/${tenant.slug}/paginas/envios/`}>Envíos</a> ·
          <a href={`/t/${tenant.slug}/paginas/devoluciones/`}>Devoluciones</a> ·
          <a href={`/t/${tenant.slug}/paginas/preguntas-frecuentes/`}>Preguntas frecuentes</a>
        </span>
        <BrandCredit client:load tenantSlug={tenant.slug} footerBrand={tenant.footerBrand} />
      </div>
    </footer>

    <TierDock client:load />
    <script>
      import { initReveal } from '../lib/reveal';
      initReveal();
    </script>
  </body>
</html>
