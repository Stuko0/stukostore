---
import '../styles/global.css';
import DemoBadge from '../components/demo/DemoBadge.tsx';

interface Props {
  title: string;
  description: string;
  announcement?: string;
}

const { title, description, announcement } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const barra = announcement ?? 'Migración de catálogo incluida · Facturación en bolivianos · Sin contrato mínimo';

// GitHub Pages cannot send response headers, so the policy ships as a meta tag.
// 'unsafe-inline' is required for Astro's hydration bootstrap; the same policy
// becomes header-based (and inline-free) when the site moves behind Cloudflare.
// `frame-ancestors` is deliberately absent: browsers ignore it in a meta tag,
// so clickjacking protection is documented as a header-only control in
// SECURITY.md instead of being declared where it does nothing.
const csp = [
  "default-src 'self'",
  "img-src 'self' data:",
  "style-src 'self' 'unsafe-inline'",
  "script-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  "connect-src 'self'",
  "base-uri 'none'",
  "form-action 'self'",
  "object-src 'none'",
].join('; ');
---

<!doctype html>
<html lang="es-BO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#ffffff" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:site_name" content="StukoStore" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${base}fonts/jost-600.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/lato-400.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <div class="announce" role="region" aria-label="Avisos de la tienda">
      <div class="shell announce__inner">
        <p>{barra}</p>
      </div>
    </div>

    <header class="bar bar--light">
      <div class="shell bar__inner">
        <a class="bar__brand" href={base}>
          <span class="mono" aria-hidden="true">S</span>
          StukoStore
        </a>
        <nav class="bar__nav" aria-label="Navegación principal">
          <a href={`${base}#producto`}>Producto</a>
          <a href={`${base}precios/`}>Precios</a>
          <a href={`${base}demo/`}>Demo</a>
          <a href="https://github.com/Stuko0/stukostore" rel="noopener noreferrer">Código</a>
          <DemoBadge client:load />
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="foot">
      <div class="shell foot__inner">
        <span>StukoStore — Cochabamba, Bolivia</span>
        <span class="caption">Hecho por <a href="https://stuko.dev" target="_blank" rel="noopener noreferrer">Stuko</a></span>
        <span class="caption">Precios en bolivianos · 1 USD ≈ 11,8 Bs</span>
      </div>
    </footer>
    <script>
      import { initReveal } from '../lib/reveal';
      initReveal();
    </script>
  </body>
</html>
